# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Sendblue (iMessage). Group messaging requires the Sapphire plan or above.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Shared secret Sendblue sends back on webhooks (configure in the Sendblue dashboard)
SENDBLUE_WEBHOOK_SECRET=
# The name people type after "@" to address the bot
BOT_NAME=planner

# Supabase. Leave blank to run on the in-memory store (local dev / tests).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (free/busy scope only). Redirect URI to register:
#   ${PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the "connect your calendar" links texted to members
LINK_SECRET=change-me

# Claude. Leave blank to use the rule-based parser and template messages.
ANTHROPIC_API_KEY=

# Default timezone for parsing requests and rendering times
DEFAULT_TIMEZONE=America/Los_Angeles

# How often the scheduler checks for reminders and deadlines (ms)
SCHEDULER_INTERVAL_MS=60000
